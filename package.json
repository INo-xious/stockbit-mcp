{
  "name": "stockbit-mcp",
  "version": "0.1.0",
  "description": "MCP server for Stockbit (Indonesian / IDX market) — bandarmology, quotes, orderbook, fundamentals, your portfolio, and drawing on your real chart. Order entry is off by default and confirm-gated. Unofficial; uses your own session.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stockbit-mcp": "dist/bin/stockbit-mcp.js",
    "stockbit-auth": "dist/bin/stockbit-auth.js",
    "stockbit-alerts": "dist/bin/stockbit-alerts.js"
  },
  "exports": {
    ".": "./dist/src/server.js",
    "./core": "./dist/src/core/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin/stockbit-mcp.js",
    "auth": "node dist/bin/stockbit-auth.js",
    "test": "node --test --import tsx test/*.test.ts",
    "dev:mcp": "node --import tsx bin/stockbit-mcp.ts",
    "dev:auth": "node --import tsx bin/stockbit-auth.ts",
    "progress": "node progress/build.mjs",
    "progress:serve": "node progress/serve.mjs",
    "alerts": "node dist/bin/stockbit-alerts.js",
    "dev:alerts": "node --import tsx bin/stockbit-alerts.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
